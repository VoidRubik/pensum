{
  "installCommand": "npm ci --omit=dev",
  "outputDirectory": "site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/pet.js": {
      "includeFiles": "{ai.js,gemini.js,ledger.js,logic.js}",
      "maxDuration": 15
    },
    "api/health.js": {
      "maxDuration": 5
    }
  }
}
